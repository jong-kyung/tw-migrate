{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":timezone(Asia/Seoul)",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on monday"
    ]
  },
  "packageRules": [
    {
      "matchDepNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "groupName": "napi-rs",
      "matchPackageNames": [
        "napi",
        "napi-derive",
        "napi-build",
        "@napi-rs/cli"
      ]
    },
    {
      "groupName": "oxc",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^oxc/"
      ]
    },
    {
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "npm devDependencies (non-major)",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies",
        "catalog"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "groupName": "pnpm package manager",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager"
      ],
      "matchDepNames": [
        "pnpm"
      ],
      "schedule": [
        "before 10am on the first day of the month"
      ]
    },
    {
      "groupName": "vite-plus",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-*"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "cargo-major"
      ]
    },
    {
      "description": "vitest and @vitest/* must stay pinned to the version bundled by vite-plus. Rerun `vp migrate` after a vite-plus upgrade to re-align the catalog pin instead of letting Renovate bump them independently.",
      "matchPackageNames": [
        "vitest",
        "/^@vitest\\//"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^rust-toolchain\\.toml$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\"",
        "toolchain: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    }
  ]
}