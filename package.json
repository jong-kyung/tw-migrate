{
  "name": "tw-migrate",
  "version": "0.1.0",
  "description": "Preview and migrate React CSS to Tailwind utilities",
  "keywords": [
    "codemod",
    "css",
    "css-modules",
    "migration",
    "napi-rs",
    "react",
    "tailwind",
    "tailwindcss"
  ],
  "homepage": "https://github.com/jong-kyung/tw-migrate#readme",
  "bugs": {
    "url": "https://github.com/jong-kyung/tw-migrate/issues"
  },
  "license": "MIT",
  "author": "JongKyung Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jong-kyung/tw-migrate.git"
  },
  "bin": {
    "tw-migrate": "bin/tw-migrate.js"
  },
  "files": [
    "bin",
    "html.js",
    "index.js",
    "index.d.ts",
    "native.js",
    "rfcs",
    "style-compiler.js"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --manifest-path crates/tw_migrate/Cargo.toml --package-json-path package.json --output-dir . --platform --release --no-js --dts binding.d.ts",
    "build:debug": "napi build --manifest-path crates/tw_migrate/Cargo.toml --package-json-path package.json --output-dir . --platform --no-js --dts binding.d.ts",
    "artifacts": "napi artifacts --output-dir . --npm-dir npm",
    "test": "cargo test && pnpm build:debug && node --test",
    "test:ecosystem": "node ecosystem-ci/run.ts",
    "test:rust": "cargo test",
    "typecheck": "tsc --noEmit",
    "snapshots:prepare": "node -e \"const fs=require('node:fs'); for(const dir of fs.readdirSync('npm')) for(const file of fs.readdirSync('npm/'+dir)) if(file.endsWith('.node')) fs.rmSync('npm/'+dir+'/'+file)\" && pnpm build && pnpm artifacts",
    "test:snapshots": "pnpm snapshots:prepare && cargo test -p tw-migrate-snapshots",
    "prepare": "vp config"
  },
  "dependencies": {
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3",
    "@types/node": "22.20.1",
    "@vitest/browser-playwright": "catalog:",
    "less": "4.7.0",
    "playwright": "1.61.1",
    "sass": "1.101.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "verdaccio": "6.8.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "tw-migrate-darwin-arm64": "workspace:*",
    "tw-migrate-darwin-x64": "workspace:*",
    "tw-migrate-linux-arm64-gnu": "workspace:*",
    "tw-migrate-linux-x64-gnu": "workspace:*",
    "tw-migrate-win32-x64-msvc": "workspace:*"
  },
  "napi": {
    "binaryName": "tw-migrate",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.15.1"
}
